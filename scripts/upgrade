#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source /usr/share/yunohost/helpers

path_no_slash=${path#/}

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading source files..."

# Download, check integrity, uncompress and patch the source from manifest.toml
ynh_setup_source --dest_dir="$install_dir" --full_replace --keep="public/storage storage .env"

#=================================================
# UPDATE A CONFIG FILE
#=================================================
ynh_script_progression "Updating $app's configuration files..."

# Check for app_key, create it if doesn't exist, then save as a setting (I think we had at some point app_key in .env empty in old installs)
pushd $install_dir
	if [ -z "${app_key:-}" ]; then
	    app_key=$(grep -E '^APP_KEY=' "$install_dir/.env" | cut -d '=' -f2- | tr -d "\"'\r")
	    if [ -z "$app_key" ]; then
	        app_key=$(ynh_exec_as_app php$php_version artisan key:generate --show)
	    fi
	    ynh_app_setting_set --key=app_key --value="$app_key"
	fi
popd

# .env file has been updated upstream, this must be reflected in the package
ynh_config_add --template=".env" --destination="$install_dir/.env"
chmod 640 "$install_dir/.env"

#=================================================
# REAPPLY SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add_phpfpm

ynh_config_add_nginx

#=================================================
# INSTALL 2FAUTH WITH COMPOSER
#=================================================
ynh_script_progression "Installing $app with Composer..."

ynh_safe_rm $install_dir/package-lock.json

ynh_composer_exec install --prefer-dist --no-scripts --no-dev

#=================================================
# BUILDING
#=================================================
ynh_script_progression "Building..."

ynh_composer_exec update

pushd $install_dir
	php$php_version artisan cache:clear
	php$php_version artisan config:clear
	php$php_version artisan view:clear
	php$php_version artisan route:clear
	php$php_version artisan migrate -n
	php$php_version artisan passport:install -n
	php$php_version artisan config:cache -n
	php$php_version artisan route:cache
	# Check if the symlink exusts and the destination also, if one of them doesn't > create link
	# This fixes icons not showing
	[ -L public/storage ] && [ -e public/storage ] || php$php_version artisan storage:link
popd

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
